# Copy to .env (gitignored) and fill in. On Render/Vercel, set these in the platform's env settings instead.

# Supabase project: Settings -> API. The service-role key is SERVER-SIDE ONLY - never ship it to a frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional overrides. If unset, defaults to the repo-committed files in data/.
# VOCAB_JSON=/absolute/path/to/vocab.json
# CREATORS_XLSX=/absolute/path/to/creator_workbook.xlsx   (seed.py only)
# MAPPINGS_XLSX=/absolute/path/to/mapping_tables.xlsx     (seed.py only)
